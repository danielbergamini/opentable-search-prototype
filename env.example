# Used only by scripts/index.js (never exposed to the browser)
APP_ID=your_application_id
ADMIN_KEY=your_admin_api_key

# Used by the browser app (Vite only exposes VITE_-prefixed vars). Use the SEARCH-ONLY key here.
VITE_ALGOLIA_APP_ID=your_application_id
VITE_ALGOLIA_SEARCH_KEY=your_search_only_api_key
